## Service endpoints
# scripts/run_demo.py uses llm-guard as an in-process Python library — no URL/key needed
# for the actual demo. LLM_GUARD_URL/AUTH_TOKEN are only read by the optional
# docker-compose.yml service (see README Quickstart).
LLM_GUARD_URL=http://localhost:8000
AUTH_TOKEN=local-dev-only
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=<pin-your-model-tag-here>

## Red-team harness
GARAK_PROBES=dan,knownbadsignatures,promptinject
GARAK_REPORT=reports/garak/

## Observability (optional — export_trace.py no-ops cleanly without these)
# Point at your own self-hosted Langfuse instance — this project does not ship or
# require its own Langfuse stack.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...